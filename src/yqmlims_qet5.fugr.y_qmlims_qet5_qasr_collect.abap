FUNCTION Y_QMLIMS_QET5_QASR_COLLECT.
*"----------------------------------------------------------------------
*"*"Lokale Schnittstelle:
*"  IMPORTING
*"     VALUE(IV_PRUEFLOS) TYPE  QPLOS
*"     VALUE(IV_VORGLFNR) TYPE  QLFNKN
*"     VALUE(IV_MERKNR) TYPE  QMERKNRP
*"     VALUE(IV_PROBENR) TYPE  QSTIPRONR
*"     VALUE(IV_ORIGINAL_INPUT) TYPE  QORIGINAL_INPUT
*"     VALUE(IV_SET_FEHLKLAS) TYPE  QKZ OPTIONAL
*"  TABLES
*"      ET_QASR STRUCTURE  QASR
*"----------------------------------------------------------------------

  DATA: LS_QASR TYPE QASR.

  LS_QASR-PRUEFLOS = IV_PRUEFLOS.
  LS_QASR-VORGLFNR = IV_VORGLFNR.
  LS_QASR-MERKNR   = IV_MERKNR.
  LS_QASR-PROBENR  = IV_PROBENR.

  IF IV_SET_FEHLKLAS = 'X'.
    LS_QASR-FEHLKLAS = '90'.
  ELSE.
    CLEAR LS_QASR-FEHLKLAS.
  ENDIF.

  LS_QASR-ORIGINAL_INPUT = IV_ORIGINAL_INPUT.

  READ TABLE UT_QASR INTO US_QASR
             WITH KEY PRUEFLOS = IV_PRUEFLOS
                      VORGLFNR = IV_VORGLFNR
                      MERKNR   = IV_MERKNR
                      PROBENR  = IV_PROBENR.
  IF SY-SUBRC = 0.
    MOVE-CORRESPONDING LS_QASR TO US_QASR.
    MODIFY UT_QASR FROM US_QASR INDEX SY-TABIX.
  ELSE.
    APPEND LS_QASR TO UT_QASR.
  ENDIF.

  ET_QASR[] = UT_QASR[].

ENDFUNCTION.
