*&---------------------------------------------------------------------*
*&      Form  CHANGE_PHYSICAL_SAMPLE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM CHANGE_PHYSICAL_SAMPLE .

  DATA: LS_QAPP TYPE QAPP.
  DATA: LT_QAPP TYPE TABLE OF QAPP.

  SELECT PRUEFLOS VORGLFNR PROBENR TPLNR PHYNR FROM QAPP
  INTO CORRESPONDING FIELDS OF TABLE LT_QAPP
  WHERE PRUEFLOS = OBJECT_TAB-PRUEFLOS .
  IF SY-SUBRC <> 0.
    REFRESH LT_QAPP.
  ELSE.
    SORT LT_QAPP BY PRUEFLOS TPLNR PHYNR.
    DELETE ADJACENT DUPLICATES FROM LT_QAPP COMPARING PRUEFLOS TPLNR PHYNR.
  ENDIF.

  LOOP AT LT_QAPP INTO LS_QAPP WHERE PHYNR NE SPACE.
    SET PARAMETER ID 'QPN' FIELD LS_QAPP-PHYNR.
    CALL TRANSACTION 'QPR2' AND SKIP FIRST SCREEN.
  ENDLOOP.

ENDFORM.
