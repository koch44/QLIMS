FUNCTION Y_QMLIMS_QET5_QASR_QASPTAB_UP.
*"----------------------------------------------------------------------
*"*"Lokale Schnittstelle:
*"  IMPORTING
*"     VALUE(I_PRUEFLOS) TYPE  QALS-PRUEFLOS
*"  TABLES
*"      T_SAVETAB STRUCTURE  QASPR
*"----------------------------------------------------------------------

  DATA: LS_QASR  TYPE QASR.
  DATA: LS_QASPR TYPE QASPR.
  DATA: LT_QASPR TYPE TABLE OF QASPR.

  LT_QASPR[] = T_SAVETAB[].

  CALL FUNCTION 'QETM_SAVE_TABLE_QASPTAB'
    EXPORTING
      I_PRUEFLOS  = I_PRUEFLOS
    TABLES
      T_SAVETAB   = T_SAVETAB
    EXCEPTIONS
      TABLE_EMPTY = 0.

  LOOP AT UT_QASR INTO LS_QASR
  WHERE PRUEFLOS   = I_PRUEFLOS.
    REFRESH T_SAVETAB[].
    LOOP AT LT_QASPR INTO LS_QASPR
      WHERE PRUEFLOS = LS_QASR-PRUEFLOS
      AND   VORGLFNR = LS_QASR-VORGLFNR
      AND   MERKNR   = LS_QASR-MERKNR
      AND   PROBENR  = LS_QASR-PROBENR.
      LS_QASPR-FEHLKLAS       = LS_QASR-FEHLKLAS. "'90'.
      LS_QASPR-ORIGINAL_INPUT = LS_QASR-ORIGINAL_INPUT.
      MODIFY LT_QASPR FROM LS_QASPR.
    ENDLOOP.
*    IF sy-subrc = 0.
*      DELETE TABLE ut_qasr FROM ls_qasr.
*    ELSE.
    CALL FUNCTION 'QEEM_FETCH_LAST_QASPTAB'
      EXPORTING
        I_PRUEFLOS        = LS_QASR-PRUEFLOS
        I_VORGLFNR        = LS_QASR-VORGLFNR
        I_MERKNR          = LS_QASR-MERKNR
        I_PROBENR         = LS_QASR-PROBENR
      IMPORTING
        E_QASPR           = LS_QASPR
      EXCEPTIONS
        NO_INSPECTION_LOT = 1
        QAMKTAB_EMPTY     = 2
        QASPTAB_EMPTY     = 3
        OTHERS            = 4.
    IF SY-SUBRC = 0.
      REFRESH T_SAVETAB[].
      LS_QASPR-FEHLKLAS       = LS_QASR-FEHLKLAS. "'90'.
      LS_QASPR-ORIGINAL_INPUT = LS_QASR-ORIGINAL_INPUT.
      APPEND LS_QASPR TO T_SAVETAB.
      CALL FUNCTION 'QETM_SAVE_TABLE_QASPTAB'
        EXPORTING
          I_PRUEFLOS  = I_PRUEFLOS
        TABLES
          T_SAVETAB   = T_SAVETAB
        EXCEPTIONS
          TABLE_EMPTY = 0.

      DELETE TABLE UT_QASR FROM LS_QASR.
    ENDIF.
  ENDLOOP.

  T_SAVETAB[] = LT_QASPR[].

ENDFUNCTION.
